#!/bin/bash
ready=/var/lib/fwos/lan-services-ready
result=/var/lib/fwos/lan-services-result
last_generation=
declare -A applied_digest=()
umask 077

# Quadlet's READY notification is from conmon, before the daemon has parsed
# its config. Reject a bad config before disturbing a running service.
preflight_config() {
  case "$1" in
    fwos-kea-dhcp4)
      timeout 8 podman run --rm --network=ns:/run/netns/fwd \
        --volume=/var/lib/fwos/kea:/etc/kea:ro \
        --security-opt=label=disable --cap-drop=all --runtime=/usr/bin/crun --user=0 \
        --rootfs /usr/lib/fwos/addons/kea:O \
        /usr/bin/kea-dhcp4 -X -T /etc/kea/kea-dhcp4.conf >/dev/null 2>&1
      ;;
    fwos-kea-dhcp6)
      timeout 8 podman run --rm --network=ns:/run/netns/fwd \
        --volume=/var/lib/fwos/kea:/etc/kea:ro \
        --security-opt=label=disable --cap-drop=all --runtime=/usr/bin/crun --user=0 \
        --rootfs /usr/lib/fwos/addons/kea:O \
        /usr/bin/kea-dhcp6 -X -T /etc/kea/kea-dhcp6.conf >/dev/null 2>&1
      ;;
    fwos-unbound)
      timeout 8 podman run --rm --network=ns:/run/netns/fwd \
        --volume=/var/lib/fwos/unbound:/etc/unbound:ro \
        --security-opt=label=disable --cap-drop=all --runtime=/usr/bin/crun --user=0 \
        --rootfs /usr/lib/fwos/addons/unbound:O \
        /usr/sbin/unbound-checkconf /etc/unbound/unbound.conf >/dev/null 2>&1
      ;;
  esac
}

while true; do
  generation=$(cat "$ready" 2>/dev/null)
  if [ -n "$generation" ]; then
    if [ "$generation" != "$last_generation" ]; then
      all_applied=true
      failed_service=
      superseded=false
      changed=false
      for name in fwos-kea-dhcp4 fwos-kea-dhcp6 fwos-unbound; do
        case "$name" in
          fwos-kea-dhcp4) config=/var/lib/fwos/kea/kea-dhcp4.conf ;;
          fwos-kea-dhcp6) config=/var/lib/fwos/kea/kea-dhcp6.conf ;;
          fwos-unbound) config=/var/lib/fwos/unbound/unbound.conf ;;
        esac
        if [ "$(cat "$ready" 2>/dev/null)" != "$generation" ]; then
          superseded=true
          break
        fi
        if [ -f "$config" ]; then
          digest=$(sha256sum "$config" 2>/dev/null)
          digest=${digest%% *}
          if [ -z "$digest" ]; then
            all_applied=false
            failed_service=$name
            continue
          fi
          if [ "$(cat "$ready" 2>/dev/null)" != "$generation" ]; then
            superseded=true
            break
          fi
          action_ok=true
          if timeout 2 systemctl is-active --quiet "$name.service"; then
            if [ "$digest" != "${applied_digest[$name]}" ]; then
              changed=true
              if preflight_config "$name"; then
                timeout 6 systemctl restart "$name.service" || action_ok=false
              else
                action_ok=false
              fi
            fi
          else
            changed=true
            if preflight_config "$name"; then
              timeout 2 systemctl reset-failed "$name.service" 2>/dev/null || true
              timeout 6 systemctl start "$name.service" || action_ok=false
            else
              action_ok=false
            fi
          fi
          if $action_ok && timeout 2 systemctl is-active --quiet "$name.service"; then
            applied_digest[$name]=$digest
          else
            all_applied=false
            failed_service=$name
          fi
        elif timeout 2 systemctl is-active --quiet "$name.service"; then
          changed=true
          if timeout 6 systemctl stop "$name.service" &&
             ! timeout 2 systemctl is-active --quiet "$name.service"; then
            unset 'applied_digest[$name]'
          else
            all_applied=false
            failed_service=$name
          fi
        else
          unset 'applied_digest[$name]'
        fi
      done
      if $changed && ! $superseded; then
        # A container may report active before its daemon parses/binds.
        # Require the same live MainPID across several samples before ACK.
        declare -A stable_pid=()
        for sample in 1 2 3; do
          for name in fwos-kea-dhcp4 fwos-kea-dhcp6 fwos-unbound; do
            case "$name" in
              fwos-kea-dhcp4) config=/var/lib/fwos/kea/kea-dhcp4.conf ;;
              fwos-kea-dhcp6) config=/var/lib/fwos/kea/kea-dhcp6.conf ;;
              fwos-unbound) config=/var/lib/fwos/unbound/unbound.conf ;;
            esac
            if [ -f "$config" ]; then
              pid=$(timeout 2 systemctl show --property=MainPID --value "$name.service")
              if ! timeout 2 systemctl is-active --quiet "$name.service" ||
                 ! [[ "$pid" =~ ^[1-9][0-9]*$ ]] ||
                 { [ "$sample" -gt 1 ] && [ "$pid" != "${stable_pid[$name]}" ]; }; then
                all_applied=false
                failed_service=$name
              fi
              stable_pid[$name]=$pid
            elif timeout 2 systemctl is-active --quiet "$name.service"; then
              all_applied=false
              failed_service=$name
            fi
          done
          if [ "$sample" -lt 3 ]; then sleep 1; fi
        done
      fi
      if [ "$(cat "$ready" 2>/dev/null)" != "$generation" ]; then
        superseded=true
      fi
      if ! $superseded; then
        status=ok
        if ! $all_applied; then
          status="failed:$failed_service"
        fi
        temporary="${result}.$$"
        if printf '%s %s\n' "$generation" "$status" > "$temporary" &&
           mv -f -- "$temporary" "$result"; then
          last_generation=$generation
        else
          rm -f -- "$temporary"
          sleep 1
        fi
      fi
    fi
  else
    last_generation=
  fi
  sleep 0.2
done
