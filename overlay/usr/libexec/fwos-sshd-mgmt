#!/bin/bash
set -e
# sshd in mgmt fails label transitions; this is the injected-key test adapter,
# not published first-boot (ADR-0032).
if [ ! -f /home/fwos/.ssh/authorized_keys ] && [ ! -f /var/home/fwos/.ssh/authorized_keys ]; then
  exit 0
fi
setenforce 0 || true
systemctl stop sshd.service sshd.socket 2>/dev/null || true
systemctl reset-failed fwos-sshd.service 2>/dev/null || true
systemctl start fwos-sshd.service
systemctl is-active --quiet fwos-sshd.service

