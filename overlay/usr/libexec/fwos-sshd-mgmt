#!/bin/bash
set -e
# sshd in mgmt fails label transitions; this is the test-adapter path, not published first-boot.
setenforce 0 || true
systemctl stop sshd.service sshd.socket 2>/dev/null || true
systemctl reset-failed fwos-sshd.service 2>/dev/null || true
systemctl start fwos-sshd.service
systemctl is-active --quiet fwos-sshd.service

